# Marginalia Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED
# =============================================================================

# Your Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=

# =============================================================================
# OPTIONAL - Claude Settings
# =============================================================================

# Claude model to use (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# =============================================================================
# OPTIONAL - Database
# =============================================================================

# Database URL (default: SQLite in current directory)
# DATABASE_URL=sqlite+aiosqlite:///./marginalia.db

# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/marginalia

# =============================================================================
# OPTIONAL - Notion Integration
# =============================================================================

# Notion API key (get one at https://www.notion.so/my-integrations)
# NOTION_API_KEY=

# Notion database ID for your reading queue
# NOTION_QUEUE_DATABASE_ID=

# Notion database ID for research agenda (optional)
# NOTION_RESEARCH_AGENDA_DATABASE_ID=

# =============================================================================
# OPTIONAL - Obsidian Integration
# =============================================================================

# Path to your Obsidian vault
# OBSIDIAN_VAULT_PATH=/path/to/your/vault

# Folder for Claude's draft notes (default: inbox)
# OBSIDIAN_INBOX_FOLDER=inbox

# Folder containing concept notes (default: concepts)
# OBSIDIAN_CONCEPTS_FOLDER=concepts

# =============================================================================
# OPTIONAL - Storage
# =============================================================================

# Base storage path (default: ./storage)
# STORAGE_PATH=./storage

# PDF storage path (default: ./storage/pdfs)
# PDF_STORAGE_PATH=./storage/pdfs

# =============================================================================
# OPTIONAL - Security (change in production!)
# =============================================================================

# Secret key for session signing
# SECRET_KEY=your-secret-key-here

# Environment (development, production, test)
# ENVIRONMENT=development
